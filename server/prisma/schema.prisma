// QR Restaurant Ordering System - Prisma schema
// Multi-tenant from day one. Every tenant-owned table carries restaurantId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // In Prisma v7, the connection URL is configured in prisma.config.js
  // rather than here. The provider still needs to be declared.
  provider = "postgresql"
}

// This schema uses Postgres (via Supabase — see the datasource block
// above), so it uses Postgres's native enum-friendly String columns for
// consistency with earlier SQLite-compatible history, though real Postgres
// enums would work here too if you prefer. Allowed values are enforced at
// the application layer — see server/src/validators/schemas.js (Zod enums)
// and the order state machine in server/src/utils/order.js.
//
//   User.role         legacy-compatible display name; effective capabilities
//                     are read from the tenant-scoped Role/Permission relations.
//   Order.orderType    "DINE_IN" | "TAKEAWAY"
//   Order.status        "PENDING" | "ACCEPTED" | "PREPARING" | "READY" | "COMPLETED" | "CANCELLED"
//   Order.paymentStatus  "PENDING" | "PAID" | "FAILED" | "REFUNDED"
//   Payment.status       "PENDING" | "PAID" | "FAILED" | "REFUNDED"

model Restaurant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED
  cuisineType String? // free text, e.g. "North Indian", "Cafe", "Fast Food" — shown/grouped on the platform dashboard
  taxPercent      Float @default(0)
  serviceChargePercent Float @default(0)
  discountPercent Float @default(0) // blanket/default discount applied automatically to every order, unless a coupon is used instead
  discountEnabled Boolean @default(false) // master on/off for the blanket discount — lets admins keep a percent configured without it silently applying
  searchEnabled Boolean @default(true) // whether customers see the menu search bar; toggled from Admin > Settings

  // ---- Open / closed ("out of service") ----
  isOpen Boolean @default(true) // master "open sign" — admin flips this off manually to force Out of Service immediately
  autoScheduleEnabled Boolean @default(false) // if true, ALSO auto-close outside openTime–closeTime even if isOpen is true
  openTime  String? // "HH:MM" 24h, in `timezone` below, e.g. "10:00"
  closeTime String? // "HH:MM" 24h, e.g. "23:00" — closeTime < openTime is treated as spanning midnight
  timezone  String  @default("Asia/Kolkata")

  // ---- Geofencing ("in-dine only": block orders from outside the premises) ----
  geofenceEnabled      Boolean @default(false)
  latitude             Float?
  longitude            Float?
  geofenceRadiusMeters Int     @default(200)

  // ---- WhatsApp/SMS: phone OTP verification + order notifications ----
  phoneVerificationEnabled  Boolean @default(false) // require a verified phone before an order can be placed
  orderNotificationsEnabled Boolean @default(true)  // send WhatsApp/SMS order confirmation + status updates
  notificationChannel       String  @default("whatsapp") // "whatsapp" | "sms" — preferred channel; falls back to SMS if WhatsApp send fails
  notificationPhone         String? // Direct phone for restaurant owner alerts
  ownerAlertsEnabled        Boolean @default(true)  // Send alerts to owner on new orders
  currency  String   @default("INR")
  defaultLanguage String @default("en")
  logoUrl   String?
  websiteThemeVersion Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  roles      Role[]
  auditLogs  AuditLog[]
  tables     Table[]
  categories Category[]
  menuItems  MenuItem[]
  orders     Order[]
  coupons    Coupon[]
  websiteThemeVersions WebsiteThemeVersion[]
  marketplaceEvents MarketplaceWebhookEvent[]
  inventoryItems InventoryItem[]
  inventoryMovements InventoryMovement[]
  recipeComponents RecipeComponent[]
  inventorySuppliers InventorySupplier[]
  inventoryPurchases InventoryPurchase[]
  subscriptions Subscription[]
  pendingOnboardings PendingOnboarding[]
  platformInvites PlatformRestaurantInvite[]
  staffAccessLinks RestaurantStaffAccessLink[]
  supportTickets PlatformSupportTicket[]
  floorLayouts   FloorLayout[]
  aiConversations AiConversation[]
  aiActionProposals AiActionProposal[]
  aiUsageLogs    AiUsageLog[]

  @@index([slug])
}

model Coupon {
  id                String    @id @default(uuid())
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code              String    // stored uppercased; unique per restaurant
  type              String    // "PERCENT" | "FLAT"
  value             Float     // percent (0-100) or flat amount, depending on type
  isActive          Boolean   @default(true)
  minOrderAmount    Float     @default(0)
  maxDiscountAmount Float?    // caps the discount for PERCENT coupons on large orders
  usageLimit        Int?      // null = unlimited
  usageCount        Int       @default(0)
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([restaurantId, code])
  @@index([restaurantId])
}

model User {
  id           String   @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  role         String   @default("STAFF") // "ADMIN" | "STAFF"
  roleId       String?
  roleRecord   Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  phone        String?
  lastLoginAt  DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  preferredLanguage String @default("en")
  inventoryMovementsCreated InventoryMovement[] @relation("InventoryMovementActor")
  inventoryPurchasesCreated InventoryPurchase[] @relation("InventoryPurchaseActor")
  platformInvites PlatformRestaurantInvite[]
  staffAccessLinksReceived RestaurantStaffAccessLink[] @relation("RestaurantStaffAccessLinkTarget")
  staffAccessLinksCreated RestaurantStaffAccessLink[] @relation("RestaurantStaffAccessLinkCreator")
  aiConversations AiConversation[]
  aiActionProposals AiActionProposal[]
  aiUsageLogs    AiUsageLog[]

  @@unique([restaurantId, email])
  @@index([restaurantId])
  @@index([restaurantId, roleId])
}

model Role {
  id           String   @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String   @default("")
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@unique([restaurantId, name])
  @@index([restaurantId, isSystem])
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  group       String
  label       String
  description String   @default("")

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id           String   @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String?
  action       String
  resource     String
  resourceId   String?
  metadata     String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, resource, resourceId])
}

model Table {
  id           String   @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableNumber  String
  tableToken   String   @unique @default(uuid())
  capacity     Int      @default(4)
  section      String   @default("Indoor")
  shape        String   @default("round") // "round" | "square" | "rectangle" | "custom"
  posX         Float    @default(120)
  posY         Float    @default(120)
  width        Float    @default(90)
  height       Float    @default(90)
  rotation     Float    @default(0)
  chairCount   Int      @default(4)
  chairPositions Json?
  status       String   @default("AVAILABLE") // "AVAILABLE" | "OCCUPIED" | "RESERVED" | "CLEANING" | "DISABLED"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@index([restaurantId, section])
}

model Category {
  id            String   @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  translations  Json?
  imageUrl      String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  menuItems MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id           String   @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  translations Json?
  price        Float
  imageUrl     String?
  isVeg        Boolean  @default(true)
  isAvailable  Boolean  @default(true)
  isBestseller Boolean  @default(false)
  isDeleted    Boolean  @default(false)
  variants     Json?
  addons       Json?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems OrderItem[]
  recipeComponents RecipeComponent[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, isDeleted])
}

model Order {
  id             String   @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId        String?
  table          Table?   @relation(fields: [tableId], references: [id])
  orderType      String   @default("DINE_IN") // "DINE_IN" | "TAKEAWAY"
  source         String   @default("SVAADYA_QR") // SVAADYA_QR | SVAADYA_WEBSITE | SWIGGY | ZOMATO | MANUAL
  externalOrderId String?
  idempotencyKey String?
  idempotencyFingerprint String?
  settlementStatus String @default("NOT_APPLICABLE") // NOT_APPLICABLE | PENDING | SETTLED | FAILED
  paymentMethod  String   @default("ONLINE") // ONLINE | CASH | MARKETPLACE | MANUAL
  sourceStatus   String? // original provider status when an authorized adapter is enabled
  syncStatus     String   @default("NOT_REQUIRED") // NOT_REQUIRED | PENDING | SYNCED | FAILED | TEST_ONLY
  syncError      String?
  sourceUpdatedAt DateTime?
  syncedAt       DateTime?
  sourceMetadata String? // sanitized JSON only; never credentials or raw webhook bodies
  orderNumber    String   @unique
  status         String   @default("PENDING") // see enum note above
  paymentStatus  String   @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  subtotal       Float
  taxAmount      Float  @default(0)
  serviceCharge  Float  @default(0)
  discountAmount Float  @default(0)
  couponCode     String? // snapshot of the coupon code applied, if any (default discount leaves this null)
  totalAmount    Float
  customerName   String?
  customerPhone  String?
  orderSessionToken String @default(uuid()) // lets guest customer poll/track without an account
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]
  feedback Feedback?
  marketplaceEvents MarketplaceWebhookEvent[]

  @@index([restaurantId])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, paymentStatus])
  @@index([restaurantId, source, createdAt])
  @@unique([restaurantId, source, externalOrderId])
  @@unique([restaurantId, idempotencyKey])
  @@index([tableId, createdAt])
  @@index([status, createdAt])
  @@index([tableId])
  @@index([orderSessionToken])
}

model Feedback {
  id           String   @id @default(uuid())
  orderId      String   @unique // one review per order
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurantId String   // denormalized for fast admin queries without joining through Order
  rating       Int      // 1-5, enforced in validators/schemas.js
  comment      String?
  createdAt    DateTime @default(now())

  @@index([restaurantId, createdAt])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  itemName   String   // snapshot
  unitPrice  Float   // snapshot
  quantity   Int
  instructions String?
  lineTotal  Float

  @@index([orderId])
}

model Payment {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String   @default("razorpay")
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  amount            Float
  currency          String   @default("INR")
  status            String   @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  failureReason     String?
  // Kept as a plain string (not Prisma's native Json type) — Postgres
  // supports Json natively if you want to switch this later, but a string
  // column needed no migration when this schema moved between SQLite and
  // Postgres. Written with JSON.stringify(...) and read back with
  // JSON.parse(...) in paymentService.js.
  rawWebhookPayload String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@unique([provider, providerPaymentId])
}

// Deliberately NOT a User with some special role — every User row is
// scoped to exactly one restaurantId and restaurant-side code (requireAuth,
// every service function) assumes that and filters by it. Bolting
// cross-tenant visibility onto that model would mean auditing every query
// in the app for a missed restaurantId filter. A separate model + separate
// login + separate JWT type keeps the blast radius of a bug in one system
// from leaking into the other. See server/src/services/platformAuthService.js.
model PlatformAdmin {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  passwordHash        String
  platformRole        String   @default("READ_ONLY_AUDITOR")
  isActive            Boolean  @default(true)
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  auditEvents       PlatformAdminAuditLog[] @relation("PlatformAuditActor")
  restaurantInvites PlatformRestaurantInvite[] @relation("PlatformRestaurantInviteCreator")
  assignedTickets   PlatformSupportTicket[] @relation("AssignedTickets")
  aiConversations   AiConversation[]
  aiActionProposals AiActionProposal[]
  aiUsageLogs       AiUsageLog[]
}

model PlatformAdminAuditLog {
  id            String   @id @default(uuid())
  actorAdminId  String?
  actor         PlatformAdmin? @relation("PlatformAuditActor", fields: [actorAdminId], references: [id], onDelete: SetNull)
  targetAdminId String?
  targetRestaurantId String?
  action        String
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([targetAdminId, createdAt])
}

model PlatformRestaurantInvite {
  id               String   @id @default(uuid())
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId           String
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByAdminId String?
  createdByAdmin   PlatformAdmin? @relation("PlatformRestaurantInviteCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  tokenHash        String   @unique
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([userId, consumedAt, expiresAt])
  @@index([restaurantId, createdAt])
}

model PlatformSupportTicket {
  id              String         @id @default(uuid())
  ticketNumber    Int            @default(autoincrement())
  restaurantId    String?
  restaurant      Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  title           String
  description     String
  status          String         @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  priority        String         @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  category        String         @default("GENERAL") // BILLING | TECHNICAL | ONBOARDING | GENERAL
  contactEmail    String?
  contactPhone    String?
  assignedAdminId String?
  assignedAdmin   PlatformAdmin? @relation("AssignedTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  internalNotes   String         @default("")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, priority])
  @@index([restaurantId])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL") // GENERAL | BRANDING | SECURITY | NOTIFICATIONS
  description String   @default("")
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model RestaurantStaffAccessLink {
  id               String   @id @default(uuid())
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId           String
  user             User @relation("RestaurantStaffAccessLinkTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdByUserId  String?
  createdBy        User? @relation("RestaurantStaffAccessLinkCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  purpose          String
  tokenHash        String   @unique
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([userId, purpose, consumedAt, expiresAt])
  @@index([restaurantId, userId, purpose, consumedAt])
  @@unique([userId, purpose])
}

model PendingOnboarding {
  id                String   @id @default(uuid())
  restaurantName    String
  cuisineType       String?
  adminName         String
  adminEmail        String
  emailClaim        String?  @unique
  passwordHash      String?
  planKey           String
  billingPeriod     String
  amount            Float
  currency          String   @default("INR")
  status            String   @default("PENDING_PAYMENT") // PENDING_PAYMENT | ACTIVATED | EXPIRED | FAILED
  expiresAt         DateTime
  restaurantId      String?
  restaurant        Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payments SubscriptionPayment[]
  subscription Subscription?

  @@index([status, expiresAt])
  @@index([adminEmail, createdAt])
}

model Subscription {
  id                    String   @id @default(uuid())
  restaurantId          String
  restaurant            Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  pendingOnboardingId   String?  @unique
  pendingOnboarding     PendingOnboarding? @relation(fields: [pendingOnboardingId], references: [id], onDelete: SetNull)
  planKey               String
  billingPeriod         String
  amount                Float
  currency              String   @default("INR")
  status                String // TRIALING | ACTIVE | PAST_DUE | EXPIRED | CANCELLED | GRANDFATHERED
  startsAt              DateTime
  endsAt                DateTime?
  trialEndsAt           DateTime?
  graceEndsAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  payments SubscriptionPayment[]

  @@index([restaurantId, status, endsAt])
}

model SubscriptionPayment {
  id                  String   @id @default(uuid())
  pendingOnboardingId String?
  pendingOnboarding   PendingOnboarding? @relation(fields: [pendingOnboardingId], references: [id], onDelete: SetNull)
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider            String
  providerOrderId     String?  @unique
  providerPaymentId   String?  @unique
  amount              Float
  currency            String   @default("INR")
  billingPeriod       String?
  status              String   @default("PENDING") // PENDING | PAID | FAILED
  failureCode         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([pendingOnboardingId, status])
  @@index([subscriptionId, createdAt])
}

model BillingWebhookEvent {
  id               String   @id @default(uuid())
  provider         String
  eventId          String
  processingStatus String   @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED
  errorCode        String?
  receivedAt       DateTime @default(now())
  processedAt      DateTime?

  @@unique([provider, eventId])
  @@index([processingStatus, receivedAt])
}

// Short-lived OTP codes for phone verification. Not tied to a User/Order —
// verification happens before an order exists. A successful verify() issues
// a signed, short-expiry JWT (see utils/auth.js signPhoneVerificationToken)
// that the client then attaches to order creation; this table is never
// consulted again after that point.
model PhoneOtp {
  id        String   @id @default(uuid())
  phone     String
  // HMAC-SHA-256 keyed by the platform JWT secret; raw OTP values are never stored.
  codeHash  String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  verifiedAt DateTime?
  // Set when a newer code supersedes this one or provider delivery fails.
  invalidatedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// Best-effort delivery log for every WhatsApp/SMS send attempt (OTPs and
// order notifications alike) — lets a restaurant owner or platform admin
// see whether a message actually went out, without needing to check the
// server logs. A failed send here never blocks or rolls back the order/OTP
// flow that triggered it; see messagingService.js.
model NotificationLog {
  id              String    @id @default(uuid())
  restaurantId    String?
  orderId         String?
  phone           String
  channel         String    // "whatsapp" | "sms"
  purpose         String    // "otp" | "order_confirmation" | "order_status" | "owner_order_alert" | "staff_invite" | "subscription_alert"
  status          String    // "queued" | "sent" | "delivered" | "failed" | "undelivered"
  provider        String    @default("twilio") // "twilio" | "meta" | "mock"
  providerRef     String?   // Twilio Message SID (SM... or MM...)
  idempotencyKey  String?   @unique
  errorCode       String?   // Sanitized Twilio / Meta error code
  errorMessage    String?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([restaurantId, createdAt])
  @@index([orderId])
  @@index([phone, createdAt])
  @@index([status])
}

model CommunicationTemplate {
  id          String   @id @default(uuid())
  key         String   @unique
  channel     String   @default("both") // "sms" | "whatsapp" | "both"
  title       String
  body        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Immutable-by-convention theme revisions; editing and rollback create new versions.
model WebsiteThemeVersion {
  id           String   @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  version      Int
  status       String   @default("DRAFT") // DRAFT | PUBLISHED
  config       String   // validated presentation-only JSON
  createdBy    String?
  createdAt    DateTime @default(now())
  publishedAt DateTime?

  @@unique([restaurantId, version])
  @@index([restaurantId, status, version])
}

// Dedupe record for authorized provider webhook events. Raw payloads and
// signatures are not retained here.
model MarketplaceWebhookEvent {
  id               String   @id @default(uuid())
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  source           String // SWIGGY | ZOMATO
  eventId          String
  externalOrderId  String?
  orderId          String?
  order             Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sourceUpdatedAt  DateTime?
  processingStatus String   @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | STALE
  errorCode        String?
  receivedAt       DateTime @default(now())
  processedAt      DateTime?

  @@unique([restaurantId, source, eventId])
  @@index([restaurantId, source, receivedAt])
  @@index([orderId])
}

model InventoryItem {
  id                String   @id @default(uuid())
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name              String
  sku               String?
  baseUnit          String
  quantity          Float    @default(0)
  lowStockThreshold Float    @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  conversions InventoryUnitConversion[]
  movements   InventoryMovement[]
  recipes     RecipeComponent[]
  purchaseLines InventoryPurchaseLine[]

  @@unique([restaurantId, sku])
  @@index([restaurantId, isActive, name])
}

model InventoryUnitConversion {
  id                String   @id @default(uuid())
  inventoryItemId   String
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  unitName          String
  multiplierToBase  Float
  createdAt         DateTime @default(now())

  @@unique([inventoryItemId, unitName])
}

model InventoryMovement {
  id               String   @id @default(uuid())
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  inventoryItemId  String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdById      String?
  createdBy        User? @relation("InventoryMovementActor", fields: [createdById], references: [id], onDelete: SetNull)
  type             String // RECEIPT | ADJUSTMENT | WASTE | ORDER_CONSUMPTION | CANCELLATION_RESTOCK
  quantityDelta    Float
  quantityBefore   Float
  quantityAfter    Float
  unit             String
  reason           String
  referenceId      String?
  idempotencyKey   String?
  createdAt        DateTime @default(now())

  purchaseLine InventoryPurchaseLine?

  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, inventoryItemId, createdAt])
  @@index([restaurantId, referenceId, type])
}

model InventorySupplier {
  id           String   @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  contactName  String?
  email        String?
  phone        String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchases InventoryPurchase[]

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive, name])
}

model InventoryPurchase {
  id             String   @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       InventorySupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User? @relation("InventoryPurchaseActor", fields: [createdById], references: [id], onDelete: SetNull)
  invoiceNumber  String?
  notes          String?
  totalCost      Float    @default(0)
  currency       String   @default("INR")
  idempotencyKey String
  purchasedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  lines InventoryPurchaseLine[]

  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, purchasedAt])
  @@index([restaurantId, supplierId, purchasedAt])
}

model InventoryPurchaseLine {
  id                String   @id @default(uuid())
  purchaseId        String
  purchase          InventoryPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItemId   String
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  movementId        String   @unique
  movement          InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  quantity          Float
  unit              String
  unitCost          Float?
  createdAt         DateTime @default(now())

  @@unique([purchaseId, inventoryItemId])
  @@index([inventoryItemId, createdAt])
}

model RecipeComponent {
  id                String   @id @default(uuid())
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId        String
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId   String
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantityPerItem   Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([restaurantId, menuItemId, inventoryItemId])
  @@index([restaurantId, menuItemId])
}

model FloorLayout {
  id           String   @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  section      String   @default("Indoor")
  objects      Json?    // Array of floor objects: walls, doors, windows, counters, reception, restrooms, labels
  gridSnap     Boolean  @default(true)
  gridSize     Int      @default(20)
  canvasWidth  Float    @default(1600)
  canvasHeight Float    @default(1000)
  zoom         Float    @default(1.0)
  panX         Float    @default(0)
  panY         Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([restaurantId, section])
  @@index([restaurantId])
}

model AiConversation {
  id              String         @id @default(uuid())
  scope           String         @default("RESTAURANT") // "RESTAURANT" | "PLATFORM"
  restaurantId    String?
  restaurant      Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  platformAdminId String?
  platformAdmin   PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)
  title           String         @default("New Conversation")
  currentModule   String?
  language        String         @default("en")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  messages        AiMessage[]
  proposals       AiActionProposal[]

  @@index([restaurantId, userId])
  @@index([platformAdminId])
  @@index([createdAt])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // "user" | "assistant" | "system" | "tool"
  content        String
  toolCalls      Json?
  toolCallId     String?
  actionProposal Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model AiActionProposal {
  id                   String          @id @default(uuid())
  restaurantId         String?
  restaurant           Restaurant?     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  platformAdminId      String?
  platformAdmin        PlatformAdmin?  @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)
  conversationId       String?
  conversation         AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  actionType           String          // "DRAFT_PURCHASE_ORDER" | "DRAFT_MENU_ITEM" | "DRAFT_COUPON" | "UPDATE_TABLE_SEATS" | "EXPORT_REPORT"
  actionPayload        Json
  status               String          @default("PROPOSED") // "PROPOSED" | "APPROVED" | "REJECTED" | "EXECUTED"
  requiresElevatedRole Boolean         @default(false)
  approvedBy           String?
  approvedAt           DateTime?
  executedAt           DateTime?
  executionResult      Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([restaurantId, status])
  @@index([conversationId])
}

model AiUsageLog {
  id               String         @id @default(uuid())
  scope            String         @default("RESTAURANT") // "RESTAURANT" | "PLATFORM"
  restaurantId     String?
  restaurant       Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  platformAdminId  String?
  platformAdmin    PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)
  model            String
  promptTokens     Int            @default(0)
  completionTokens Int            @default(0)
  totalTokens      Int            @default(0)
  estimatedCostUsd Float          @default(0)
  latencyMs        Int            @default(0)
  success          Boolean        @default(true)
  errorMessage     String?
  createdAt        DateTime       @default(now())

  @@index([restaurantId, createdAt])
  @@index([platformAdminId, createdAt])
}
