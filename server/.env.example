# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- Database (Supabase Postgres) ----
# From your Supabase project: Settings > Database > Connection string.
# DATABASE_URL: the "Transaction" pooler connection (port 6543) — used for
#   normal app queries. Add ?pgbouncer=true so Prisma knows not to use
#   prepared statements, which the transaction pooler doesn't support.
# DIRECT_URL: the direct connection (port 5432) — used only when running
#   `prisma db push` to change the schema.
# Both use the same password (set when you created the Supabase project,
# or reset it under Settings > Database).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[email protected]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:[email protected]:5432/postgres

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- Payments (Razorpay) ----
# Leave PAYMENT_PROVIDER=mock to develop/test without real Razorpay keys.
# Switch to "razorpay" in production once keys are set.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Messaging (WhatsApp/SMS via Twilio) ----
# Leave MESSAGING_PROVIDER=mock to develop/test phone OTP verification and
# order notifications without a real Twilio account — sends are logged to
# the console and recorded in the NotificationLog table instead of actually
# going out. Switch to "twilio" once the values below are filled in.
# Only relevant for restaurants that turn on "Require phone verification"
# or "Order notifications" in Admin > Settings — both default to safe
# values (verification off, notifications on but harmless in mock mode).
MESSAGING_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio's own format — include the "whatsapp:" prefix for the WhatsApp
# sender (e.g. their sandbox number "whatsapp:+14155238886" while testing,
# or your approved WhatsApp Business sender in production).
TWILIO_WHATSAPP_FROM=
# Plain E.164 number for the SMS sender/fallback, e.g. +14155550123
TWILIO_SMS_FROM=

# ---- File storage (menu item / category photos) ----
# "supabase" uploads directly to a Supabase Storage bucket (recommended —
# survives deploys/restarts with no volume to configure). "local" saves to
# disk at server/uploads instead, which needs a persistent volume mounted
# there on most hosts or uploaded photos vanish on the next deploy.
STORAGE_PROVIDER=supabase
# From your Supabase project: Settings > API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The SERVICE ROLE key (not the anon/public key) — this is a secret, never
# expose it to the browser. Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Create this bucket once in Supabase: Storage > New bucket, name it
# "menu-images", and mark it Public (so <img> tags can load photos
# directly without a signed URL).
SUPABASE_STORAGE_BUCKET=menu-images

# ---- URLs / CORS ----
# Same-origin deploys (the default: this Express server builds and serves
# the client itself) only need these two, and they're normally identical.
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# Split deploys only (e.g. React client on Cloudflare Pages, this API on
# Railway/Render, on different domains): comma-separated list of extra
# origins allowed to call the API / connect over Socket.io, on top of
# CLIENT_URL. Include your Pages production domain and, if you want preview
# deploys to work too, the *.pages.dev wildcard equivalents you use.
# Example: ALLOWED_ORIGINS=https://order.example.com,https://menu-preview.pages.dev
ALLOWED_ORIGINS=

# In production, redirects any plain-HTTP request to HTTPS. Leave this
# alone (true) on almost every host — it's a no-op if your host already
# terminates HTTPS in front of this process (Railway, Render, Cloudflare
# all do). Only relevant for a bare VPS with nothing else enforcing HTTPS.
FORCE_HTTPS=true

# ---- Misc ----
LOG_LEVEL=info
