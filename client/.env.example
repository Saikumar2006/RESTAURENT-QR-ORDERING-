# Leave these BLANK for the default single-process deploy (Express serves
# this client itself — see server/src/app.js). The client then talks to the
# API and Socket.io on the same origin via relative paths, no config needed.
#
# Set VITE_API_URL only if you're deploying the client SEPARATELY from the
# API — e.g. this client on Cloudflare Pages, the API on Railway/Render.
# These are read at BUILD time (Vite inlines them into the bundle), so set
# them in the Cloudflare Pages project's build environment variables, not
# just in a local .env if you're building on Pages' own CI.
VITE_API_URL=
